{
    "name": "@work-tools/source",
    "version": "0.0.0",
    "license": "MIT",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*",
        "packages/libs/*",
        "packages/shared/*",
        "packages/runttime/*",
        "packages/modules/*",
        "packages/components/*",
        "packages/tools/*"
    ],
    "scripts": {
        "test": "jest",
        "config:toml:generate": "node --import @swc-node/register/esm tools/tomlConfigGenerate/index.mjs",
        "db:up": "pm2 start tools/docker/ecosystem.config.cjs",
        "db:up:mongo": "pm2 start tools/docker/ecosystem.config.cjs --only db-mongo",
        "db:up:clickhouse": "pm2 start tools/docker/ecosystem.config.cjs --only db-clickhouse",
        "db:up:nats": "pm2 start tools/docker/ecosystem.config.cjs --only db-nats",
        "db:down": "pm2 delete db-mongo db-clickhouse db-nats",
        "db:status": "pm2 status db-mongo db-clickhouse db-nats"
    },
    "packageManager": "yarn@4.12.0",
    "devDependencies": {
        "@biomejs/biome": "2.4.6",
        "@nestjs/schematics": "11.0.9",
        "@nx/devkit": "22.5.4",
        "@nx/esbuild": "22.5.4",
        "@nx/js": "22.5.4",
        "@nx/nest": "22.5.4",
        "@nx/node": "22.5.4",
        "@nx/plugin": "22.5.4",
        "@nx/web": "22.5.4",
        "@nx/webpack": "22.5.4",
        "@swc-node/register": "1.11.1",
        "@swc/cli": "0.8.0",
        "@swc/core": "1.15.18",
        "@swc/helpers": "0.5.19",
        "@types/iarna__toml": "2.0.5",
        "@types/mime-types": "3.0.1",
        "@types/node": "25.5.0",
        "esbuild": "0.27.4",
        "lefthook": "2.1.4",
        "memfs": "4.56.11",
        "mongodb-memory-server": "11.0.1",
        "nx": "22.5.4",
        "ts-node": "10.9.2",
        "tslib": "2.8.1",
        "typescript": "5.9.3",
        "webpack-cli": "6.0.1"
    },
    "dependencies": {
        "@fast-csv/format": "5.0.5",
        "@fast-csv/parse": "5.0.5",
        "@grammyjs/files": "1.2.0",
        "@iarna/toml": "2.2.5",
        "@inquirer/prompts": "8.3.0",
        "dotenv": "17.3.1",
        "execa": "9.6.1",
        "fast-glob": "3.3.3",
        "grammy": "1.41.1",
        "inquirer": "13.3.0",
        "js7z-tools": "2.5.0",
        "mime-types": "3.0.2",
        "nats": "2.29.3",
        "node-7z-archive": "1.1.7",
        "node-xlsx": "0.24.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "telegram": "2.26.22",
        "yarn": "^1.22.22"
    }
}
